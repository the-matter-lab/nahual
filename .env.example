# Copy to .env, customize, then: set -a; source .env; set +a
NAHUAL_QWEN3_0pt6B_DIR=models/Qwen3-0.6B
# Downloaded data (python -m nahual.prepare download) and its tokenized form.
NAHUAL_RAW_DIR=data/raw
NAHUAL_PROCESSED_DIR=data/processed
NAHUAL_ASSET_DIR=data
# Hugging Face repo for the data (default the-matter-lab/nahual) and its type (default: try both).
# NAHUAL_DATA_REPO=the-matter-lab/nahual
# NAHUAL_DATA_REPO_TYPE=model
# Worker processes for CPU-heavy metrics (GEOM coverage, xTB relaxation; default 16).
# NAHUAL_METRIC_WORKERS=16
# xtb binary for the microsolvation relaxation (default: xtb on PATH).
# NAHUAL_XTB=xtb
# Unix time of a hard job deadline: training checkpoints and stops shortly before it.
# NAHUAL_STOP_AT=
# Python used by scripts/prepare_data.sh (default .venv/bin/python, else python).
# NAHUAL_PYTHON=python
